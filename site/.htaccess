# =================================================================
# RaplMail website (raplmail.em-production.eu) - static files only.
#   /                     the page
#   /updates/latest.json  what installed RaplMail apps check for updates
#   /download/            the installers (versioned names, never change)
# =================================================================

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# ACME / cert challenges stay open.
RewriteRule ^\.well-known/ - [L]

# Force HTTPS (also correct behind the TLS-terminating proxy).
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Dotfiles (.htaccess, editor files) -> 404.
RewriteRule (^|/)\. - [R=404,L]

# /download and /download/ hand out the newest installer - a link that never goes
# stale. stage-release.py writes the file name in for each release.
RewriteRule ^download/?$ https://%{HTTP_HOST}/download/__LATEST_SETUP__ [R=302,L]

# Folders without the trailing slash (/wiki, /download): add it here, on https.
# Apache's own slash redirect would say http:// - it can't see the TLS proxy -
# and Chrome blocks a download whose redirects pass through plain http.
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+[^/])$ https://%{HTTP_HOST}/$1/ [R=301,L]
</IfModule>

AddType application/json .json
AddType application/x-msdownload .exe
AddType application/x-msi .msi
AddType text/plain .sig
AddType image/webp .webp
AddType font/woff2 .woff2

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # The update feed must never be stale: a new version shows up the moment it's
  # uploaded. Readable cross-origin so the app's browser dev build can read it.
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # Installers have the version in their name - cache them for good, and save
  # them instead of opening them.
  <FilesMatch "\.(exe|msi)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set Content-Disposition "attachment"
  </FilesMatch>

  # Fonts never change; the page, styles, script and screenshots are replaced in
  # place with each release, so they're only kept for a day.
  <FilesMatch "\.(woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|css|js|webp|png|ico)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
